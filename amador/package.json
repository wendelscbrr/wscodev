{
  "name": "amador-violinist",
  "private": true,
  "description": "Site de AMADOR • Violinist (David Amador) — gerador das páginas ES/EN, CSS (Tailwind) e utilitários",
  "scripts": {
    "build": "node scripts/build-pages.cjs && npm run build:css",
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o site/assets/css/style.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/input.css -o site/assets/css/style.css --watch",
    "images": "node scripts/images.cjs",
    "dev": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "sharp": "0.33.5",
    "tailwindcss": "3.4.16"
  }
}
